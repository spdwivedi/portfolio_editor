<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Dwivedi.AI Studio</title>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Urbanist:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://unpkg.com/@simplewebauthn/browser/dist/bundle/index.umd.min.js"></script>
    <style>
        /* ===========================================================
           FUTURISTIC GLOBAL VARIABLE REGISTRIES & STYLES
        =========================================================== */
        :root {
            --bg-base: #000000; --bg-surface: #050508; --bg-card: #0c0c12;
            --accent-primary: #00f0ff; --accent-secondary: #ff007f; --accent-success: #39ff14; --accent-warning: #eab308;
            --text-main: #f8fafc; --text-muted: #475569; --glass-border: rgba(0, 240, 255, 0.15);
            --font-sans: 'Urbanist', sans-serif; --font-mono: 'Fira Code', monospace;
        }
        body.light-mode {
            --bg-base: #f8fafc; --bg-surface: #ffffff; --bg-card: #f1f5f9;
            --accent-primary: #0284c7; --accent-secondary: #be123c; --accent-success: #16a34a; --accent-warning: #ca8a04;
            --text-main: #0f172a; --text-muted: #94a3b8; --glass-border: rgba(2, 132, 199, 0.2);
        }
        * { box-sizing: border-box; margin: 0; padding: 0; transition: background-color 0.2s ease, border-color 0.2s ease; }
        body { background-color: var(--bg-base); color: var(--text-main); font-family: var(--font-sans); padding: 30px; line-height: 1.5; overflow-x: hidden; }
        .studio-container { max-width: 1800px; margin: 0 auto; }
        header { border-bottom: 1px solid var(--glass-border); padding-bottom: 20px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center; }
        h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.5px; }
        h1 span { color: var(--accent-primary); text-shadow: 0 0 12px rgba(0, 240, 255, 0.35); }
        .workspace-switcher { display: flex; background: var(--bg-card); padding: 5px; border-radius: 12px; border: 1px solid var(--glass-border); gap: 6px; }
        .mode-btn { background: transparent; border: 1px solid transparent; color: var(--text-muted); padding: 10px 24px; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; cursor: pointer; border-radius: 8px; }
        .mode-btn.active#globalProjectModeBtn { background: rgba(0, 240, 255, 0.1) !important; color: var(--accent-primary) !important; border-color: rgba(0, 240, 255, 0.25); box-shadow: 0 0 10px rgba(0, 240, 255, 0.15); }
        .mode-btn.active#globalCertModeBtn { background: rgba(234, 179, 8, 0.1) !important; color: var(--accent-warning) !important; border-color: rgba(234, 179, 8, 0.25); box-shadow: 0 0 10px rgba(234, 179, 8, 0.15); }
        .mode-btn.active#globalUserModeBtn { background: rgba(57, 255, 20, 0.1) !important; color: var(--accent-success) !important; border-color: rgba(57, 255, 20, 0.25); box-shadow: 0 0 10px rgba(57, 255, 20, 0.15); }
        .header-controls { display: flex; align-items: center; gap: 15px; }
        .theme-toggle-btn { background: var(--bg-card); border: 1px solid var(--glass-border); color: var(--accent-primary); width: 40px; height: 40px; border-radius: 8px; cursor: pointer; display: grid; place-items: center; }
        .passkey-register-btn { background: rgba(57, 255, 20, 0.05); border: 1px solid var(--accent-success); color: var(--accent-success); padding: 8px 14px; border-radius: 8px; font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px; text-transform: uppercase; }
        .passkey-register-btn:hover { background: var(--accent-success); color: #000; box-shadow: 0 0 12px rgba(57,255,20,0.3); }
        .logout-btn { background: rgba(255, 0, 127, 0.05); border: 1px solid var(--accent-secondary); color: var(--accent-secondary); padding: 8px 14px; border-radius: 8px; font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px; text-transform: uppercase; text-decoration: none; }
        .logout-btn:hover { background: var(--accent-secondary); color: #fff; box-shadow: 0 0 12px rgba(255,0,127,0.3); }
        .vfx-registry-panel { background: var(--bg-surface); border: 1px solid var(--glass-border); border-radius: 16px; padding: 24px; margin-bottom: 35px; box-shadow: 0 20px 40px rgba(0,0,0,0.5); }
        .registry-grid-tracker { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-top: 25px; }
        .config-card-node { background: var(--bg-card); border: 1px solid rgba(255,255,255,0.02); border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 14px; }
        .cyber-switch-container { display: flex; justify-content: space-between; align-items: center; width: 100%; }
        .switch-label-stack span { display: block; font-size: 0.9rem; font-weight: 600; }
        .switch-label-stack small { font-size: 0.72rem; color: var(--text-muted); font-family: var(--font-mono); }
        .cyber-toggle-input { display: none; }
        .cyber-toggle-label { width: 46px; height: 24px; background: #1e293b; display: block; border-radius: 20px; position: relative; cursor: pointer; border: 1px solid rgba(255,255,255,0.05); }
        .cyber-toggle-label::after { content: ''; position: absolute; width: 18px; height: 18px; background: #64748b; top: 2px; left: 2px; border-radius: 50%; transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
        .cyber-toggle-input:checked + .cyber-toggle-label { background: rgba(0, 240, 255, 0.15); border-color: var(--accent-primary); }
        .cyber-toggle-input:checked + .cyber-toggle-label::after { left: 24px; background: var(--accent-primary); box-shadow: 0 0 8px var(--accent-primary); }
        .cyber-range-slider { -webkit-appearance: none; width: 100%; height: 5px; background: #1e293b; border-radius: 4px; outline: none; margin-top: 5px; }
        .cyber-range-slider::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px; border-radius: 50%; background: var(--accent-primary); cursor: pointer; box-shadow: 0 0 6px var(--accent-primary); }
        .scifi-subtabs-bar { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; background: rgba(255,255,255,0.02); padding: 8px; border-radius: 10px; border: 1px dashed var(--glass-border); }
        .subtab-trigger { background: transparent; border: none; color: var(--text-muted); font-family: var(--font-mono); font-size: 0.78rem; padding: 6px 14px; cursor: pointer; border-radius: 6px; text-transform: uppercase; }
        .subtab-trigger.active { background: var(--accent-secondary); color: #fff; box-shadow: 0 0 10px rgba(255,0,127,0.3); }
        .page-scope-pane { display: none; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; margin-top: 15px; }
        .page-scope-pane.active { display: grid; }
        .matrix-checkbox-card { background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.03); border-radius: 8px; padding: 10px; display: flex; align-items: center; justify-content: space-between; }
        .studio-grid { display: grid; grid-template-columns: 440px 1fr; gap: 35px; align-items: start; }
        .control-panel { background: var(--bg-surface); border: 1px solid var(--glass-border); border-radius: 16px; padding: 24px; position: sticky; top: 30px; max-height: calc(100vh - 60px); overflow-y: auto; box-shadow: 0 15px 40px rgba(0,0,0,0.6); }
        .control-panel::-webkit-scrollbar { width: 4px; }
        .control-panel::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.05); border-radius: 2px; }
        .control-panel:hover::-webkit-scrollbar-thumb { background: var(--glass-border); }
        .panel-title { font-size: 1.15rem; font-weight: 700; margin-bottom: 20px; color: var(--accent-primary); display: flex; justify-content: space-between; align-items: center; }
        .panel-title.cert-panel-accent { color: var(--accent-warning); }
        .cancel-edit-btn { font-size: 0.75rem; font-family: var(--font-mono); color: var(--accent-secondary); cursor: pointer; display: none; margin-left: auto; margin-right: 10px; }
        .form-group { margin-bottom: 14px; }
        .form-group label { display: block; font-size: 0.75rem; font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.5px; }
        .form-control { width: 100%; background: var(--bg-card); border: 1px solid rgba(255,255,255,0.04); border-radius: 8px; padding: 10px 14px; color: var(--text-main); font-family: var(--font-sans); font-size: 0.95rem; }
        .form-control:focus { outline: none; border-color: var(--accent-primary); box-shadow: 0 0 10px rgba(0, 240, 255, 0.1); }
        .cert-panel-accent .form-control:focus { border-color: var(--accent-warning); box-shadow: 0 0 10px rgba(234, 179, 8, 0.1); }
        .btn-submit { width: 100%; background: rgba(255,255,255,0.02); border: 1px solid var(--accent-primary); color: var(--accent-primary); padding: 12px; border-radius: 8px; font-family: var(--font-mono); font-size: 0.9rem; font-weight: 600; cursor: pointer; margin-top: 10px; }
        .btn-submit:hover { background: var(--accent-primary); color: #000; box-shadow: 0 0 15px rgba(0,240,255,0.2); }
        .cert-submit-btn { border-color: var(--accent-warning); color: var(--accent-warning); }
        .cert-submit-btn:hover { background: var(--accent-warning); color: #000; box-shadow: 0 0 15px rgba(234,179,8,0.2); }
        .batch-toggle { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); cursor: pointer; display: inline-block; margin-top: 15px; border-bottom: 1px dashed var(--text-muted); padding-bottom: 2px; }
        .batch-area { display: none; margin-top: 12px; background: rgba(255,255,255,0.01); padding: 12px; border-radius: 8px; border: 1px dashed rgba(255,255,255,0.05); }
        .canvas-panel { display: flex; flex-direction: column; gap: 30px; }
        .hidden-space-node { display: none !important; }
        .search-filter-bar { background: var(--bg-surface); border: 1px solid var(--glass-border); padding: 16px; border-radius: 12px; display: grid; grid-template-columns: 2fr 1fr; gap: 15px; }
        .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px; border-bottom: 1px solid rgba(255,255,255,0.04); padding-bottom: 8px; }
        .section-header h2 { font-size: 1.3rem; display: flex; align-items: center; gap: 10px; font-weight: 600; }
        .section-header h2 i { color: var(--accent-primary); }
        .section-header h2.certs-title i { color: var(--accent-warning); }
        .manager-list { display: flex; flex-direction: column; gap: 10px; }
        .manager-card { background: var(--bg-card); border: 1px solid rgba(255,255,255,0.02); border-radius: 10px; padding: 16px; display: flex; justify-content: space-between; align-items: center; }
        .manager-card:hover { border-color: var(--glass-border); }
        .card-details h3 { font-size: 1.1rem; margin-bottom: 4px; font-weight: 600; }
        .card-meta { display: flex; flex-wrap: wrap; gap: 10px; font-size: 0.8rem; font-family: var(--font-mono); color: var(--text-muted); align-items: center; }
        .meta-tag { background: rgba(0, 240, 255, 0.04); padding: 1px 8px; border-radius: 4px; color: var(--accent-primary); border: 1px solid rgba(0, 240, 255, 0.08); }
        .meta-tag.cert-tag { background: rgba(234, 179, 8, 0.04); color: var(--accent-warning); border-color: rgba(234, 179, 8, 0.08); }
        .tech-pill { background: rgba(255,255,255,0.02); padding: 1px 6px; border-radius: 4px; color: var(--text-main); }
        .card-actions { display: flex; gap: 6px; align-items: center; }
        .btn-action { background: var(--bg-surface); border: 1px solid rgba(255,255,255,0.04); color: var(--text-muted); width: 34px; height: 34px; border-radius: 6px; cursor: pointer; display: grid; place-items: center; font-size: 0.9rem; }
        .btn-action:hover { color: var(--accent-primary); border-color: var(--accent-primary); background: rgba(0, 240, 255, 0.04); }
        .btn-action.btn-delete:hover { color: var(--accent-secondary); border-color: var(--accent-secondary); background: rgba(255, 0, 127, 0.04); }
        .ordering-docks { display: flex; flex-direction: column; gap: 2px; margin-right: 4px; }
        .order-nav-btn { background: transparent; border: none; color: var(--text-muted); cursor: pointer; font-size: 0.7rem; padding: 2px; display: block; }
        .order-nav-btn:hover { color: var(--accent-primary); }
        .recycle-bin-section { background: var(--bg-surface); padding: 25px; border-radius: 16px; border: 1px solid var(--accent-secondary) !important; }
        .audit-section { background: var(--bg-surface); padding: 25px; border-radius: 16px; border: 1px solid var(--glass-border) !important; }
        .timeline { display: flex; flex-direction: column; gap: 18px; margin-top: 20px; position: relative; padding-left: 20px; }
        .timeline::before { content: ''; position: absolute; left: 4px; top: 5px; bottom: 5px; width: 1px; background: rgba(255,255,255,0.08); }
        .timeline-item { position: relative; font-size: 0.9rem; padding-left: 10px; }
        .timeline-dot { position: absolute; left: -21px; top: 6px; width: 9px; height: 9px; border-radius: 50%; background: var(--text-muted); }
        .timeline-dot.CREATE { background: var(--accent-success) !important; box-shadow: 0 0 10px var(--accent-success); }
        .timeline-dot.UPDATE { background: var(--accent-primary) !important; box-shadow: 0 0 10px var(--accent-primary); }
        .timeline-dot.SOFT_DELETE { background: var(--accent-secondary) !important; box-shadow: 0 0 10px var(--accent-secondary); }
        .timeline-dot.RESTORE { background: var(--accent-warning) !important; box-shadow: 0 0 10px var(--accent-warning); }
    </style>
</head>
<body>

<div class="studio-container">
    <%- include('../partials/studio_header') %>

    <%- include('../partials/telemetry_panel') %>

    <div class="studio-grid" id="mainDashboardCoreLayoutStudioGrid">
        <aside class="control-panel" id="sidebarPanelContainer">
            <%- include('../partials/project_sidebar') %>
            <%- include('../partials/cert_sidebar') %>
        </aside>

        <main class="canvas-panel">
            <div class="search-filter-bar" id="globalStudioSearchFilterBarRow">
                <input type="text" id="studioSearchInput" class="form-control" placeholder="⚡ Filter metrics instantly across database indices...">
                <select id="studioCategoryFilter" class="form-control">
                    <option value="ALL">Show All Categories</option>
                </select>
            </div>

            <%- include('../partials/project_control') %>

            <%- include('../partials/cert_control') %>

            <%- include('../partials/user_management') %>

            <section class="recycle-bin-section" id="projectRecycleBinContainer">
                <div class="section-header"><h2 style="color: var(--accent-secondary);"><i class="fa-solid fa-trash-arrow-up"></i> Studio Archival Recycle Container (<%= recycledProjects.length %>)</h2></div>
                <div class="manager-list">
                    <% if (recycledProjects.length === 0) { %>
                        <p style="color: var(--text-muted); font-style: italic; text-align: center; padding: 20px 0; font-size: 0.9rem;">Recycle bin container status is empty.</p>
                    <% } else { %>
                        <% recycledProjects.forEach(project => { %>
                            <div class="manager-card recycled-card" id="recycled-card-<%= project._id %>">
                                <div class="card-details">
                                    <h3 style="color: var(--text-muted); text-decoration: line-through;"><%= project.title %></h3>
                                    <div class="card-meta"><span class="meta-tag" style="color: var(--text-muted); border-color: rgba(255,255,255,0.05); background: transparent;"><%= project.category %></span><span>Purged tracking history node.</span></div>
                                </div>
                                <div class="card-actions">
                                    <button class="btn-action" style="color: var(--accent-success); border-color: rgba(57,255,20,0.15);" onclick="restoreProjectNode('<%= project._id %>')" title="Recover Component Assets"><i class="fa-solid fa-rotate-left"></i></button>
                                    <button class="btn-action btn-delete" onclick="permanentlyWipeProjectNode('<%= project._id %>')" title="TERMINAL PURGE: WIPE FOREVER"><i class="fa-solid fa-dumpster-fire"></i></button>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </section>

            <section class="audit-section" id="globalCollaboratorIntegrationLogsPanel">
                <div class="section-header" style="border: none; margin: 0;"><h2><i class="fa-solid fa-clock-rotate-left"></i> Collaborator Integration Logs</h2></div>
                <div class="timeline">
                    <% logs.forEach(log => { %>
                        <div class="timeline-item">
                            <div class="timeline-dot <%= log.actionType %>"></div>
                            <div class="timeline-time" style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 3px;"><%= new Date(log.createdAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) %></div>
                            <div class="timeline-desc" style="font-size: 0.95rem; color: var(--text-main);"><%= log.description %><span class="timeline-operator" style="color: var(--accent-primary); font-family: var(--font-mono); font-size: 0.8rem; margin-left: 6px;">@<%= log.operator %></span></div>
                        </div>
                    <% }) %>
                </div>
            </section>
        </main>
    </div>
</div>

<script>
    let currentGlobalWorkspace = 'PROJECT';

    // ASYNC BIOMETRIC REGISTRATION ENGINE
    async function registerNewPasskeyDevice() {
        try {
            const res = await fetch('/auth/register-challenge', { method: 'POST' });
            if (!res.ok) throw new Error(await res.text() || 'Identity session error.');
            const credentialPayload = await SimpleWebAuthnBrowser.startRegistration(await res.json());
            const verifyRes = await fetch('/auth/register-verify', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(credentialPayload) });
            if ((await verifyRes.json()).verified) {
                alert('⚡ [Studio Enclave]: Biometric Passkey hardware successfully bound to profile maps.');
                if (currentGlobalWorkspace === 'USER') refreshUserRegistryGrid();
            } else alert('Passkey verification failed or rejected by security handlers.');
        } catch (err) { alert('Hardware Registration Interrupted: ' + err.message); }
    }

    // DYNAMIC COMPREHENSIVE TELEMETRY SUBMISSION ENGINE
    async function commitGlobalMatrixToggles() {
        const payload = {
            vfxEngineActive: document.getElementById('vfxEngineActive').checked ? 'true' : 'false',
            systemExecutionMode: document.getElementById('systemExecutionMode').value,
            ironManIntervalMinutes: document.getElementById('ironManIntervalMinutes').value,
            thorIntervalMinutes: document.getElementById('thorIntervalMinutes').value,
            jetIntervalMinutes: document.getElementById('jetIntervalMinutes').value,
            starIntervalMinutes: document.getElementById('starIntervalMinutes').value,
            jetSpawnCount: document.getElementById('jetSpawnCount').value,
            starSpawnCount: document.getElementById('starSpawnCount').value,
            fireworksParticleDensity: document.getElementById('fireworksParticleDensity').value,
            fireworksClickProbability: document.getElementById('fireworksClickProbability').value,
            ironManFlightDuration: document.getElementById('ironManFlightDuration').value,
            thorStrikeDuration: document.getElementById('thorStrikeDuration').value,
            jetFlightDuration: document.getElementById('jetFlightDuration').value,
            shootingStarDuration: document.getElementById('shootingStarDuration').value,
            home_mario: document.getElementById('home_mario').checked ? 'true' : 'false',
            home_ironman: document.getElementById('home_ironman').checked ? 'true' : 'false',
            home_thor: document.getElementById('home_thor').checked ? 'true' : 'false',
            home_jets: document.getElementById('home_jets').checked ? 'true' : 'false',
            home_stars: document.getElementById('home_stars').checked ? 'true' : 'false',
            home_fireworks: document.getElementById('home_fireworks').checked ? 'true' : 'false',
            projects_mario: document.getElementById('projects_mario').checked ? 'true' : 'false',
            projects_ironman: document.getElementById('projects_ironman').checked ? 'true' : 'false',
            projects_thor: document.getElementById('projects_thor').checked ? 'true' : 'false',
            projects_jets: document.getElementById('projects_jets').checked ? 'true' : 'false',
            projects_stars: document.getElementById('projects_stars').checked ? 'true' : 'false',
            projects_fireworks: document.getElementById('projects_fireworks').checked ? 'true' : 'false',
            certs_mario: document.getElementById('certs_mario').checked ? 'true' : 'false',
            certs_ironman: document.getElementById('certs_ironman').checked ? 'true' : 'false',
            certs_thor: document.getElementById('certs_thor').checked ? 'true' : 'false',
            certs_jets: document.getElementById('certs_jets').checked ? 'true' : 'false',
            certs_stars: document.getElementById('certs_stars').checked ? 'true' : 'false',
            certs_fireworks: document.getElementById('certs_fireworks').checked ? 'true' : 'false',
            about_mario: document.getElementById('about_mario').checked ? 'true' : 'false',
            about_ironman: document.getElementById('about_ironman').checked ? 'true' : 'false',
            about_thor: document.getElementById('about_thor').checked ? 'true' : 'false',
            about_jets: document.getElementById('about_jets').checked ? 'true' : 'false',
            about_stars: document.getElementById('about_stars').checked ? 'true' : 'false',
            about_fireworks: document.getElementById('about_fireworks').checked ? 'true' : 'false',
            contact_mario: document.getElementById('contact_mario').checked ? 'true' : 'false',
            contact_ironman: document.getElementById('contact_ironman').checked ? 'true' : 'false',
            contact_thor: document.getElementById('contact_thor').checked ? 'true' : 'false',
            contact_jets: document.getElementById('contact_jets').checked ? 'true' : 'false',
            contact_stars: document.getElementById('contact_stars').checked ? 'true' : 'false',
            contact_fireworks: document.getElementById('contact_fireworks').checked ? 'true' : 'false',
            operator: 'Admin'
        };
        try {
            const response = await fetch('/settings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            if ((await response.json()).success) { alert('⚡ [Studio Cockpit]: Deep telemetry matrices securely written to cluster database.'); window.location.reload(); }
        } catch (err) { console.error(err); }
    }

    function switchScopeMatrixTab(event, targetPaneId) {
        document.querySelectorAll('.page-scope-pane').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.subtab-trigger').forEach(b => b.classList.remove('active'));
        document.getElementById(targetPaneId).classList.add('active');
        event.currentTarget.classList.add('active');
    }

    // MULTI-SPACE ISOLATION WORKSPACE TOGGLE ENGINE
    function toggleGlobalStudioContext(targetSpace) {
        currentGlobalWorkspace = targetSpace;
        resetFormToCreateMode();
        const tabs = { PROJECT: document.getElementById('globalProjectModeBtn'), CERT: document.getElementById('globalCertModeBtn'), USER: document.getElementById('globalUserModeBtn') };
        const sections = {
            projectForm: document.getElementById('projectSidebarBlock'), certForm: document.getElementById('certSidebarBlock'),
            projectCanvas: document.getElementById('projectSpaceWorkspaceBlock'), certCanvas: document.getElementById('certSpaceWorkspaceBlock'), userCanvas: document.getElementById('userSpaceWorkspaceBlock'),
            sidebar: document.getElementById('sidebarPanelContainer'), layoutGrid: document.getElementById('mainDashboardCoreLayoutStudioGrid'),
            bin: document.getElementById('projectRecycleBinContainer'), filter: document.getElementById('studioCategoryFilter'),
            search: document.getElementById('globalStudioSearchFilterBarRow'), logs: document.getElementById('globalCollaboratorIntegrationLogsPanel'), vfx: document.getElementById('globalVfxTelemetryRegistryControlBoard')
        };

        Object.values(tabs).forEach(t => t.classList.remove('active'));

        if (targetSpace === 'PROJECT') {
            tabs.PROJECT.classList.add('active');
            sections.projectForm.classList.remove('hidden-space-node'); sections.projectCanvas.classList.remove('hidden-space-node'); sections.bin.classList.remove('hidden-space-node'); sections.search.classList.remove('hidden-space-node'); sections.logs.classList.remove('hidden-space-node'); sections.vfx.classList.remove('hidden-space-node');
            sections.sidebar.style.display = "block"; sections.layoutGrid.style.gridTemplateColumns = "440px 1fr";
            sections.certForm.classList.add('hidden-space-node'); sections.certCanvas.style.display = "none"; sections.userCanvas.classList.add('hidden-space-node');
            sections.filter.innerHTML = `<option value="ALL">Show All Categories</option><option value="Personal Projects">Personal Projects</option><option value="College Projects">College Projects</option><option value="Udemy Projects">Udemy Projects</option><option value="Coursera Projects">Coursera Projects</option>`;
            runGlobalLiveFilteringEngine();
        } else if (targetSpace === 'CERT') {
            tabs.CERT.classList.add('active');
            sections.certForm.classList.remove('hidden-space-node'); sections.certCanvas.classList.remove('hidden-space-node'); sections.certCanvas.style.display = "block"; sections.search.classList.remove('hidden-space-node'); sections.logs.classList.remove('hidden-space-node'); sections.vfx.classList.remove('hidden-space-node');
            sections.sidebar.style.display = "block"; sections.layoutGrid.style.gridTemplateColumns = "440px 1fr";
            sections.projectForm.classList.add('hidden-space-node'); sections.projectCanvas.classList.add('hidden-space-node'); sections.bin.classList.add('hidden-space-node'); sections.userCanvas.classList.add('hidden-space-node');
            sections.filter.innerHTML = `<option value="ALL">Show All Platforms</option><option value="Udemy">Udemy</option><option value="Coursera">Coursera</option><option value="NPTEL">NPTEL</option><option value="IBM">IBM Track</option><option value="Other">Other Academic Track</option>`;
            runGlobalLiveFilteringEngine();
        } else if (targetSpace === 'USER') {
            tabs.USER.classList.add('active'); sections.userCanvas.classList.remove('hidden-space-node');
            sections.sidebar.style.display = "none"; sections.layoutGrid.style.gridTemplateColumns = "1fr";
            sections.search.classList.add('hidden-space-node'); sections.projectForm.classList.add('hidden-space-node'); sections.projectCanvas.classList.add('hidden-space-node'); sections.certForm.classList.add('hidden-space-node'); sections.certCanvas.style.display = "none"; sections.bin.classList.add('hidden-space-node'); sections.logs.classList.add('hidden-space-node'); sections.vfx.classList.add('hidden-space-node');
            refreshUserRegistryGrid();
        }
    }

    // THEME CONTROLLER
    const themeToggleBtn = document.getElementById('themeToggle');
    const themeIcon = themeToggleBtn.querySelector('i');
    if (localStorage.getItem('theme') === 'light') { document.body.classList.add('light-mode'); themeIcon.className = 'fa-solid fa-sun'; }
    themeToggleBtn.addEventListener('click', () => { document.body.classList.toggle('light-mode'); const isLight = document.body.classList.contains('light-mode'); localStorage.setItem('theme', isLight ? 'light' : 'dark'); themeIcon.className = isLight ? 'fa-solid fa-sun' : 'fa-solid fa-moon'; });

    // UNIFIED REAL-TIME SEARCH INDEX FILTER ENGINE
    const searchInput = document.getElementById('studioSearchInput');
    const categoryFilter = document.getElementById('studioCategoryFilter');
    function runGlobalLiveFilteringEngine() {
        if (currentGlobalWorkspace === 'USER') return;
        const query = searchInput.value.toLowerCase().trim();
        const value = categoryFilter.value;
        if (currentGlobalWorkspace === 'PROJECT') {
            let count = 0;
            document.querySelectorAll('.active-node-row').forEach(node => {
                if ((node.dataset.title.includes(query) || node.dataset.tags.includes(query)) && (value === 'ALL' || node.dataset.category === value)) { node.style.display = 'flex'; count++; }
                else node.style.display = 'none';
            });
            document.getElementById('activeCount').innerText = count;
        } else {
            let count = 0;
            document.querySelectorAll('.active-cert-row').forEach(node => {
                if ((node.dataset.title.includes(query) || node.dataset.platform.toLowerCase().includes(query)) && (value === 'ALL' || node.dataset.platform === value)) { node.style.display = 'flex'; count++; }
                else node.style.display = 'none';
            });
            document.getElementById('activeCertCount').innerText = count;
        }
    }
    searchInput.addEventListener('input', runGlobalLiveFilteringEngine);
    categoryFilter.addEventListener('change', runGlobalLiveFilteringEngine);

    // ASYMMETRIC GRID SEQUENCING
    async function shiftGridComponentSequence(id, direction) {
        const card = document.getElementById(`card-${id}`); const container = document.getElementById('activeProjectsWrapper');
        if (!card || !container) return;
        if (direction === 'UP') { const sibling = card.previousElementSibling; if (sibling && sibling.classList.contains('active-node-row')) container.insertBefore(card, sibling); else return; }
        else { const sibling = card.nextElementSibling; if (sibling && sibling.classList.contains('active-node-row')) container.insertBefore(sibling, card); else return; }
        const sequenceArray = Array.from(container.querySelectorAll('.active-node-row')).map((node, index) => ({ id: node.id.replace('card-', ''), orderIndex: index }));
        try { await fetch('/projects/reorder', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ sequenceArray }) }); } catch (err) { console.error(err); }
    }

    // BATCH PROCESSING MIGRATIONS
    function toggleBatchViewDisplay(type) { const el = document.getElementById(type === 'PROJECT' ? 'projectBatchWrapper' : 'certBatchWrapper'); el.style.display = window.getComputedStyle(el).display === 'none' ? 'block' : 'none'; }
    async function executeBatchDataIngestion(type) {
        const str = document.getElementById(type === 'PROJECT' ? 'projectBatchInput' : 'certBatchInput').value.trim();
        if (!str) return alert('Import string streams cannot evaluate blank payloads.');
        try {
            const arr = JSON.parse(str); if (!Array.isArray(arr)) throw new Error('Must map to an array payload.');
            const res = await fetch(`/${type === 'PROJECT' ? 'projects' : 'certificates'}/batch`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: arr, strategy: confirm('Overwrite duplicates? (Cancel to skip)') ? 'overwrite' : 'skip', operator: 'Admin' }) });
            if ((await res.json()).success) window.location.reload();
        } catch (err) { alert('Stream Aborted: ' + err.message); }
    }

    // FORM HYDRATION OPERATORS
    const fields = {
        pId: document.getElementById('projectId'), title: document.getElementById('title'), cat: document.getElementById('category'), desc: document.getElementById('description'), tags: document.getElementById('tags'), git: document.getElementById('github'), live: document.getElementById('liveUrl'), data: document.getElementById('datasetUrl'), size: document.getElementById('size'), color: document.getElementById('accentColor'), fx: document.getElementById('hoverAnimation'), titleTxt: document.getElementById('formActionTitle'), btnTxt: document.getElementById('submitProjectBtn'), cX: document.getElementById('cancelEditBtn'),
        cId: document.getElementById('certId'), cTitle: document.getElementById('certTitle'), cPlat: document.getElementById('certPlatform'), cYear: document.getElementById('certYear'), cUrl: document.getElementById('certVerifyUrl'), cTitleTxt: document.getElementById('certFormActionTitle'), cBtnTxt: document.getElementById('submitCertBtn'), cXCert: document.getElementById('cancelCertEditBtn')
    };
    function initializeEditContext(id) {
        const data = JSON.parse(document.getElementById(`card-${id}`).dataset.json);
        fields.pId.value = id; fields.title.value = data.title; fields.cat.value = data.category; fields.desc.value = data.description; fields.tags.value = data.tags ? data.tags.join(', ') : ''; fields.git.value = data.links?.github || ''; fields.live.value = data.links?.liveUrl || ''; fields.data.value = data.links?.datasetUrl || ''; fields.size.value = data.layout?.size || 'normal'; fields.color.value = data.accentColor || '#00f2ea'; fields.fx.value = data.hoverAnimation || 'aura-glow';
        fields.titleTxt.innerText = "Modify Project Configuration"; fields.btnTxt.innerText = "Save Adjustments Changes"; fields.cX.style.display = "inline"; document.getElementById('sidebarPanelContainer').scrollTop = 0;
    }
    function initializeCertEditContext(id) {
        const data = JSON.parse(document.getElementById(`cert-card-${id}`).dataset.json);
        fields.cId.value = id; fields.cTitle.value = data.title; fields.cPlat.value = data.platform; fields.cYear.value = data.year; fields.cUrl.value = data.verifyUrl || '';
        fields.cTitleTxt.innerText = "Modify Credential Matrix"; fields.cBtnTxt.innerText = "Commit Metric Changes"; fields.cXCert.style.display = "inline"; document.getElementById('sidebarPanelContainer').scrollTop = 0;
    }
    function resetFormToCreateMode() { document.getElementById('projectForm').reset(); document.getElementById('certForm').reset(); fields.pId.value = ""; fields.cId.value = ""; fields.cX.style.display = "none"; fields.cXCert.style.display = "none"; fields.titleTxt.innerText = "Add New Project"; fields.btnTxt.innerText = "Publish Component Node"; fields.cTitleTxt.innerText = "Register Certificate Node"; fields.cBtnTxt.innerText = "Register Certificate Node"; }

    // DATA MUTATION EMITTERS
    document.getElementById('projectForm').addEventListener('submit', async (e) => { e.preventDefault(); const res = await fetch(fields.pId.value ? `/projects/${fields.pId.value}` : '/projects', { method: fields.pId.value ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(e.target).entries())) }); if ((await res.json()).success) window.location.reload(); });
    document.getElementById('certForm').addEventListener('submit', async (e) => { e.preventDefault(); const res = await fetch(fields.cId.value ? `/certificates/${fields.cId.value}` : '/certificates', { method: fields.cId.value ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(e.target).entries())) }); if ((await res.json()).success) window.location.reload(); });
    async function softDeleteProjectNode(id) { if (confirm('Recycle this component card block?')) { const res = await fetch(`/projects/${id}/delete?operator=Admin`, { method: 'PATCH' }); if ((await res.json()).success) window.location.reload(); } }
    async function restoreProjectNode(id) { const res = await fetch(`/projects/${id}/restore?operator=Admin`, { method: 'PATCH' }); if ((await res.json()).success) window.location.reload(); }
    async function permanentlyWipeProjectNode(id) { if (confirm('🚨 PERMANENT WIPE: Erase node completely?')) { const res = await fetch(`/projects/${id}/permanent`, { method: 'DELETE' }); if ((await res.json()).success) window.location.reload(); } }
    async function permanentlyWipeCertificateNode(id) { if (confirm('Permanently erase this credential?')) { const res = await fetch(`/certificates/${id}?operator=Admin`, { method: 'DELETE' }); if ((await res.json()).success) window.location.reload(); } }
</script>
</body>
</html>
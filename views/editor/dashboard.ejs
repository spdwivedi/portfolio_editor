<script>
    let currentGlobalWorkspace = 'PROJECT';

    // =========================================================
    // 1. DYNAMIC COMPREHENSIVE TELEMETRY SUBMISSION ENGINE
    // =========================================================
    async function commitGlobalMatrixToggles() {
        const payload = {
            vfxEngineActive: document.getElementById('vfxEngineActive').checked ? 'true' : 'false',
            systemExecutionMode: document.getElementById('systemExecutionMode').value,
            
            ironManIntervalMinutes: document.getElementById('ironManIntervalMinutes').value,
            thorIntervalMinutes: document.getElementById('thorIntervalMinutes').value,
            jetIntervalMinutes: document.getElementById('jetIntervalMinutes').value,
            starIntervalMinutes: document.getElementById('starIntervalMinutes').value,
            
            jetSpawnCount: document.getElementById('jetSpawnCount').value,
            starSpawnCount: document.getElementById('starSpawnCount').value,
            fireworksParticleDensity: document.getElementById('fireworksParticleDensity').value,
            fireworksClickProbability: document.getElementById('fireworksClickProbability').value,
            
            ironManFlightDuration: document.getElementById('ironManFlightDuration').value,
            thorStrikeDuration: document.getElementById('thorStrikeDuration').value,
            jetFlightDuration: document.getElementById('jetFlightDuration').value, // TRANSMITTED: Custom jet pacing velocity passed to router
            shootingStarDuration: document.getElementById('shootingStarDuration').value,

            // Compile high-density page scopes
            home_mario: document.getElementById('home_mario').checked ? 'true' : 'false',
            home_ironman: document.getElementById('home_ironman').checked ? 'true' : 'false',
            home_thor: document.getElementById('home_thor').checked ? 'true' : 'false',
            home_jets: document.getElementById('home_jets').checked ? 'true' : 'false',
            home_stars: document.getElementById('home_stars').checked ? 'true' : 'false',
            home_fireworks: document.getElementById('home_fireworks').checked ? 'true' : 'false',

            projects_mario: document.getElementById('projects_mario').checked ? 'true' : 'false',
            projects_ironman: document.getElementById('projects_ironman').checked ? 'true' : 'false',
            projects_thor: document.getElementById('projects_thor').checked ? 'true' : 'false',
            projects_jets: document.getElementById('projects_jets').checked ? 'true' : 'false',
            projects_stars: document.getElementById('projects_stars').checked ? 'true' : 'false',
            projects_fireworks: document.getElementById('projects_fireworks').checked ? 'true' : 'false',

            certs_mario: document.getElementById('certs_mario').checked ? 'true' : 'false',
            certs_ironman: document.getElementById('certs_ironman').checked ? 'true' : 'false',
            certs_thor: document.getElementById('certs_thor').checked ? 'true' : 'false',
            certs_jets: document.getElementById('certs_jets').checked ? 'true' : 'false',
            certs_stars: document.getElementById('certs_stars').checked ? 'true' : 'false',
            certs_fireworks: document.getElementById('certs_fireworks').checked ? 'true' : 'false',

            about_mario: document.getElementById('about_mario').checked ? 'true' : 'false',
            about_ironman: document.getElementById('about_ironman').checked ? 'true' : 'false',
            about_thor: document.getElementById('about_thor').checked ? 'true' : 'false',
            about_jets: document.getElementById('about_jets').checked ? 'true' : 'false',
            about_stars: document.getElementById('about_stars').checked ? 'true' : 'false',
            about_fireworks: document.getElementById('about_fireworks').checked ? 'true' : 'false',

            contact_mario: document.getElementById('contact_mario').checked ? 'true' : 'false',
            contact_ironman: document.getElementById('contact_ironman').checked ? 'true' : 'false',
            contact_thor: document.getElementById('contact_thor').checked ? 'true' : 'false',
            contact_jets: document.getElementById('contact_jets').checked ? 'true' : 'false',
            contact_stars: document.getElementById('contact_stars').checked ? 'true' : 'false',
            contact_fireworks: document.getElementById('contact_fireworks').checked ? 'true' : 'false',
            
            operator: 'Admin'
        };

        try {
            const response = await fetch('/settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const result = await response.json();
            if (result.success) {
                alert('⚡ [Studio Cockpit]: Deep telemetry matrices securely written to cluster database.');
                window.location.reload();
            } else {
                alert(`Error executing transaction: ${result.error}`);
            }
        } catch (err) {
            console.error('Tuning save network fault:', err);
        }
    }

    function switchScopeMatrixTab(event, targetPaneId) {
        document.querySelectorAll('.page-scope-pane').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.subtab-trigger').forEach(b => b.classList.remove('active'));
        
        document.getElementById(targetPaneId).classList.add('active');
        event.currentTarget.classList.add('active');
    }

    // =========================================================
    // 2. SPACE ISOLATION TOGGLE ENGINE WITH ADAPTIVE FILTERS
    // =========================================================
    function toggleGlobalStudioContext(targetSpace) {
        currentGlobalWorkspace = targetSpace;
        resetFormToCreateMode();

        const projectTabBtn = document.getElementById('globalProjectModeBtn');
        const certTabBtn = document.getElementById('globalCertModeBtn');
        
        const projectFormBlock = document.getElementById('projectSidebarBlock');
        const certFormBlock = document.getElementById('certSidebarBlock');
        
        const projectCanvasBlock = document.getElementById('projectSpaceWorkspaceBlock');
        const certCanvasBlock = document.getElementById('certSpaceWorkspaceBlock');
        const recycleBinWidget = document.getElementById('projectRecycleBinContainer');
        const categoryFilterSelect = document.getElementById('studioCategoryFilter');

        if (targetSpace === 'PROJECT') {
            projectTabBtn.classList.add('active');
            certTabBtn.classList.remove('active');
            
            projectFormBlock.classList.remove('hidden-space-node');
            projectCanvasBlock.classList.remove('hidden-space-node');
            recycleBinWidget.classList.remove('hidden-space-node');
            categoryFilterSelect.classList.remove('hidden-space-node');
            
            certFormBlock.classList.add('hidden-space-node');
            certCanvasBlock.style.display = "none";
            
            categoryFilterSelect.innerHTML = `
                <option value="ALL">Show All Categories</option>
                <option value="Personal Projects">Personal Projects</option>
                <option value="College Projects">College Projects</option>
                <option value="Udemy Projects">Udemy Projects</option>
                <option value="Coursera Projects">Coursera Projects</option>
            `;
        } else {
            certTabBtn.classList.add('active');
            projectTabBtn.classList.remove('active');
            
            certFormBlock.classList.remove('hidden-space-node');
            certCanvasBlock.classList.remove('hidden-space-node');
            certCanvasBlock.style.display = "block";
            
            projectFormBlock.classList.add('hidden-space-node');
            projectCanvasBlock.classList.add('hidden-space-node');
            recycleBinWidget.classList.add('hidden-space-node');
            categoryFilterSelect.classList.remove('hidden-space-node');
            
            categoryFilterSelect.innerHTML = `
                <option value="ALL">Show All Platforms</option>
                <option value="Udemy">Udemy</option>
                <option value="Coursera">Coursera</option>
                <option value="NPTEL">NPTEL</option>
                <option value="IBM">IBM Track</option>
                <option value="Other">Other Academic Track</option>
            `;
        }
        runGlobalLiveFilteringEngine();
    }

    // =========================================================
    // 3. ENVIRONMENT THEME PERSISTENCE CACHE SWITCHER
    // =========================================================
    const themeToggleBtn = document.getElementById('themeToggle');
    const themeIcon = themeToggleBtn.querySelector('i');

    if (localStorage.getItem('theme') === 'light') {
        document.body.classList.add('light-mode');
        themeIcon.className = 'fa-solid fa-sun';
    }

    themeToggleBtn.addEventListener('click', () => {
        document.body.classList.toggle('light-mode');
        const isLight = document.body.classList.contains('light-mode');
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
        themeIcon.className = isLight ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
    });

    // =========================================================
    // 4. UNIFIED HIGH-SPEED CLIENT FILTER ENGINE
    // =========================================================
    const searchInput = document.getElementById('studioSearchInput');
    const categoryFilter = document.getElementById('studioCategoryFilter');

    function runGlobalLiveFilteringEngine() {
        const query = searchInput.value.toLowerCase().trim();
        const selectedDropdownValue = categoryFilter.value;

        if (currentGlobalWorkspace === 'PROJECT') {
            const activeNodes = document.querySelectorAll('.active-node-row');
            let visibleProjects = 0;

            activeNodes.forEach(node => {
                const matchesSearch = node.dataset.title.includes(query) || node.dataset.tags.includes(query);
                const matchesCategory = (selectedDropdownValue === 'ALL' || node.dataset.category === selectedDropdownValue);

                if (matchesSearch && matchesCategory) {
                    node.style.display = 'flex';
                    visibleProjects++;
                } else {
                    node.style.display = 'none';
                }
            });
            document.getElementById('activeCount').innerText = visibleProjects;
        } else {
            const certNodes = document.querySelectorAll('.active-cert-row');
            let visibleCerts = 0;

            certNodes.forEach(node => {
                const matchesSearch = node.dataset.title.includes(query) || node.dataset.platform.toLowerCase().includes(query);
                const matchesPlatform = (selectedDropdownValue === 'ALL' || node.dataset.platform === selectedDropdownValue);

                if (matchesSearch && matchesPlatform) {
                    node.style.display = 'flex';
                    visibleCerts++;
                } else {
                    node.style.display = 'none';
                }
            });
            document.getElementById('activeCertCount').innerText = visibleCerts;
        }
    }

    searchInput.addEventListener('input', runGlobalLiveFilteringEngine);
    categoryFilter.addEventListener('change', runGlobalLiveFilteringEngine);

    // =========================================================
    // 5. MANUAL ORDER PRECEDENCE CONFIGURATION OPERATORS
    // =========================================================
    async function shiftGridComponentSequence(id, direction) {
        const currentCard = document.getElementById(`card-${id}`);
        const parentContainer = document.getElementById('activeProjectsWrapper');
        if (!currentCard || !parentContainer) return;

        if (direction === 'UP') {
            const sibling = currentCard.previousElementSibling;
            if (sibling && sibling.classList.contains('active-node-row')) {
                parentContainer.insertBefore(currentCard, sibling);
            } else return;
        } else {
            const sibling = currentCard.nextElementSibling;
            if (sibling && sibling.classList.contains('active-node-row')) {
                parentContainer.insertBefore(sibling, currentCard);
            } else return;
        }

        const reorderedNodes = parentContainer.querySelectorAll('.active-node-row');
        const sequenceArray = Array.from(reorderedNodes).map((node, index) => ({
            id: node.id.replace('card-', ''),
            orderIndex: index
        }));

        try {
            const response = await fetch('/projects/reorder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sequenceArray })
            });
            const result = await response.json();
            if (!result.success) console.error('Ordering mismatch sequence error:', result.error);
        } catch (err) {
            console.error('Reordering infrastructure communication crash:', err);
        }
    }

    // =========================================================
    // 6. BULK DATA PACKAGE BATCH MIGRATION AGENTS
    // =========================================================
    function toggleBatchViewDisplay(type) {
        const targetId = type === 'PROJECT' ? 'projectBatchWrapper' : 'certBatchWrapper';
        const targetElement = document.getElementById(targetId);
        const currentDisplay = window.getComputedStyle(targetElement).display;
        targetElement.style.display = currentDisplay === 'none' ? 'block' : 'none';
    }

    async function executeBatchDataIngestion(type) {
        const inputId = type === 'PROJECT' ? 'projectBatchInput' : 'certBatchInput';
        const rawJsonString = document.getElementById(inputId).value.trim();
        const currentOperator = type === 'PROJECT' 
            ? (document.getElementById('operator').value || 'Admin')
            : (document.getElementById('certOperator').value || 'Admin');

        if (!rawJsonString) return alert('Import string stream cannot evaluate blank payloads.');

        let cleanParsedArray = [];
        try {
            cleanParsedArray = JSON.parse(rawJsonString);
            if (!Array.isArray(cleanParsedArray)) throw new Error('Root profile block must map to an array structure.');
        } catch (err) {
            return alert(`Invalid Data Stream Object Blueprint: ${err.message}`);
        }

        const strategyChoice = confirm('Click "OK" to OVERWRITE duplicate titles or "Cancel" to SKIP conflicting entries.') ? 'overwrite' : 'skip';
        const endpointPath = type === 'PROJECT' ? 'projects' : 'certificates';
        
        try {
            const response = await fetch(`/${endpointPath}/batch`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    items: cleanParsedArray,
                    strategy: strategyChoice,
                    operator: currentOperator
                })
            });
            const outcome = await response.json();
            if (outcome.success) {
                alert(`Ingestion Completed! Processed/Updated: ${outcome.processed} | Skipped Conflicts: ${outcome.skipped}`);
                window.location.reload();
            } else {
                alert(`Batch controller rejected request: ${outcome.error}`);
            }
        } catch (err) {
            console.error('Asynchronous transaction execution suspension fault:', err);
        }
    }

    // =========================================================
    // 7. BIDIRECTIONAL EDIT CONTEXT BACKWARD HYDRATION ENGINE
    // =========================================================
    const formActionTitle = document.getElementById('formActionTitle');
    const certFormActionTitle = document.getElementById('certFormActionTitle');
    
    const cancelEditBtn = document.getElementById('cancelEditBtn');
    const cancelCertEditBtn = document.getElementById('cancelCertEditBtn');
    
    const projectForm = document.getElementById('projectForm');
    const hiddenProjectId = document.getElementById('projectId');
    const submitProjectBtn = document.getElementById('submitProjectBtn');

    const certForm = document.getElementById('certForm');
    const hiddenCertId = document.getElementById('certId');
    const submitCertBtn = document.getElementById('submitCertBtn');

    function initializeEditContext(id) {
        const targetNode = document.getElementById(`card-${id}`);
        if (!targetNode) return;

        const configData = JSON.parse(targetNode.dataset.json);

        hiddenProjectId.value = id;
        document.getElementById('title').value = configData.title;
        document.getElementById('category').value = configData.category;
        document.getElementById('description').value = configData.description;
        document.getElementById('tags').value = configData.tags ? configData.tags.join(', ') : '';
        document.getElementById('github').value = configData.links?.github || '';
        document.getElementById('liveUrl').value = configData.links?.liveUrl || '';
        document.getElementById('datasetUrl').value = configData.links?.datasetUrl || '';
        document.getElementById('size').value = configData.layout?.size || 'normal';
        document.getElementById('accentColor').value = configData.accentColor || '#00f2ea';
        document.getElementById('hoverAnimation').value = configData.hoverAnimation || 'aura-glow';
        
        formActionTitle.innerText = "Modify Project Configuration";
        submitProjectBtn.innerText = "Save Adjustments Changes";
        cancelEditBtn.style.display = "inline";
        
        document.getElementById('sidebarPanelContainer').scrollTop = 0;
    }

    function initializeCertEditContext(id) {
        const targetNode = document.getElementById(`cert-card-${id}`);
        if (!targetNode) return;

        const configData = JSON.parse(targetNode.dataset.json);

        hiddenCertId.value = id;
        document.getElementById('certTitle').value = configData.title;
        document.getElementById('certPlatform').value = configData.platform;
        document.getElementById('certYear').value = configData.year;
        document.getElementById('certVerifyUrl').value = configData.verifyUrl || '';
        
        certFormActionTitle.innerText = "Modify Credential Matrix";
        submitCertBtn.innerText = "Commit Metric Changes";
        cancelCertEditBtn.style.display = "inline";

        document.getElementById('sidebarPanelContainer').scrollTop = 0;
    }

    function resetFormToCreateMode() {
        hiddenProjectId.value = "";
        hiddenCertId.value = "";
        projectForm.reset();
        certForm.reset();
        
        cancelEditBtn.style.display = "none";
        cancelCertEditBtn.style.display = "none";

        formActionTitle.innerText = "Add New Project";
        submitProjectBtn.innerText = "Publish Component Node";
        
        certFormActionTitle.innerText = "Register Certificate Node";
        submitCertBtn.innerText = "Register Certificate Node";
    }

    // =========================================================
    // 8. ASYNC HTTP BACKGROUND ROUTING TRANSACTION PIPELINES
    // =========================================================
    projectForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const targetId = hiddenProjectId.value;
        const formData = Object.fromEntries(new FormData(e.target).entries());

        const targetUrl = targetId ? `/projects/${targetId}` : '/projects';
        const requestMethod = targetId ? 'PUT' : 'POST';

        try {
            const response = await fetch(targetUrl, {
                method: requestMethod,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            });
            const result = await response.json();
            if (result.success) window.location.reload();
            else alert(`Transaction breakdown error context: ${result.error}`);
        } catch (err) {
            console.error('Project operational transaction pipe exception:', err);
        }
    });

    certForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const targetId = hiddenCertId.value;
        const formData = Object.fromEntries(new FormData(e.target).entries());

        const targetUrl = targetId ? `/certificates/${targetId}` : '/certificates';
        const requestMethod = targetId ? 'PUT' : 'POST';

        try {
            const response = await fetch(targetUrl, {
                method: requestMethod,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            });
            const result = await response.json();
            if (result.success) window.location.reload();
            else alert(`Credentials data sync failure reported: ${result.error}`);
        } catch (err) {
            console.error('Academic context transmission break path:', err);
        }
    });

    // =========================================================
    // 9. RECYCLE PURGE PROCESSES
    // =========================================================
    async function softDeleteProjectNode(id) {
        if (!confirm('Relocate this component node into the studio recycle storage area?')) return;
        const currentOperator = document.getElementById('operator').value || 'Admin';

        try {
            const response = await fetch(`/projects/${id}/delete?operator=${encodeURIComponent(currentOperator)}`, { method: 'PATCH' });
            const outcome = await response.json();
            if (outcome.success) window.location.reload();
            else alert(`Soft deletion engine failure context: ${outcome.error}`);
        } catch (err) {
            console.error('Archival routing layer exception:', err);
        }
    }

    async function restoreProjectNode(id) {
        const currentOperator = 'Admin';
        try {
            const response = await fetch(`/projects/${id}/restore?operator=${encodeURIComponent(currentOperator)}`, { method: 'PATCH' });
            const outcome = await response.json();
            if (outcome.success) window.location.reload();
            else alert(`Recovery layer validation breakdown: ${outcome.error}`);
        } catch (err) {
            console.error('Restoration tracking pipeline interception crash:', err);
        }
    }

    async function permanentlyWipeProjectNode(id) {
        if (!confirm('🚨 CRITICAL WARNING: Wiping a node can never be undone. Proceed?')) return;

        try {
            const response = await fetch(`/projects/${id}/permanent`, { method: 'DELETE' });
            const outcome = await response.json();
            if (outcome.success) window.location.reload();
            else alert(`Terminal infrastructure purge abort: ${outcome.error}`);
        } catch (err) {
            console.error('Hard purge structural asset drop failure:', err);
        }
    }

    async function permanentlyWipeCertificateNode(id) {
        if (!confirm('Are you certain you want to permanently erase this verified academic credential?')) return;
        const currentOperator = document.getElementById('certOperator').value || 'Admin';

        try {
            const response = await fetch(`/certificates/${id}?operator=${encodeURIComponent(currentOperator)}`, { method: 'DELETE' });
            const outcome = await response.json();
            if (outcome.success) window.location.reload();
            else alert(`Certificate node completely drop error trace: ${outcome.error}`);
        } catch (err) {
            console.error('Academic data table pop trace exception:', err);
        }
    }
</script>
</body>
</html>
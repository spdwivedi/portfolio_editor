<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Dwivedi.AI Studio</title>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Urbanist:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <style>
        /* ===========================================================
           1. FUTURISTIC STRUCTURAL VARIABLE REGISTRIES
        =========================================================== */
        :root {
            --bg-base: #000000;
            --bg-surface: #050508;
            --bg-card: #0c0c12;
            --accent-primary: #00f0ff;
            --accent-secondary: #ff007f;
            --accent-success: #39ff14;
            --accent-warning: #eab308;
            --text-main: #f8fafc;
            --text-muted: #475569;
            --glass-border: rgba(0, 240, 255, 0.15);
            --font-sans: 'Urbanist', sans-serif;
            --font-mono: 'Fira Code', monospace;
        }

        body.light-mode {
            --bg-base: #f8fafc;
            --bg-surface: #ffffff;
            --bg-card: #f1f5f9;
            --accent-primary: #0284c7;
            --accent-secondary: #be123c;
            --accent-success: #16a34a;
            --accent-warning: #ca8a04;
            --text-main: #0f172a;
            --text-muted: #94a3b8;
            --glass-border: rgba(2, 132, 199, 0.2);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; transition: background-color 0.2s ease, border-color 0.2s ease; }
        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            font-family: var(--font-sans);
            padding: 30px;
            line-height: 1.5;
            overflow-x: hidden;
        }

        .studio-container { max-width: 1800px; margin: 0 auto; }
        
        header { 
            border-bottom: 1px solid var(--glass-border); 
            padding-bottom: 20px; 
            margin-bottom: 30px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
        }
        h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.5px; }
        h1 span { color: var(--accent-primary); text-shadow: 0 0 12px rgba(0, 240, 255, 0.35); }
        
        .workspace-switcher {
            display: flex; background: var(--bg-card); padding: 5px;
            border-radius: 12px; border: 1px solid var(--glass-border); gap: 6px;
        }
        .mode-btn {
            background: transparent; border: 1px solid transparent; color: var(--text-muted);
            padding: 10px 24px; font-family: var(--font-mono); font-size: 0.85rem;
            font-weight: 600; text-transform: uppercase; cursor: pointer; border-radius: 8px;
        }
        .mode-btn.active#globalProjectModeBtn { background: rgba(0, 240, 255, 0.1) !important; color: var(--accent-primary) !important; border-color: rgba(0, 240, 255, 0.25); box-shadow: 0 0 10px rgba(0, 240, 255, 0.15); }
        .mode-btn.active#globalCertModeBtn { background: rgba(234, 179, 8, 0.1) !important; color: var(--accent-warning) !important; border-color: rgba(234, 179, 8, 0.25); box-shadow: 0 0 10px rgba(234, 179, 8, 0.15); }

        .header-controls { display: flex; align-items: center; gap: 20px; }
        .theme-toggle-btn {
            background: var(--bg-card); border: 1px solid var(--glass-border); color: var(--accent-primary);
            width: 40px; height: 40px; border-radius: 8px; cursor: pointer; display: grid; place-items: center;
        }

        /* ===========================================================
           2. HIGH-DENSITY DYNAMIC TUNING MATRIX PANEL
        =========================================================== */
        .vfx-registry-panel {
            background: var(--bg-surface); border: 1px solid var(--glass-border);
            border-radius: 16px; padding: 24px; margin-bottom: 35px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        }
        .registry-grid-tracker {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-top: 25px;
        }
        .config-card-node {
            background: var(--bg-card); border: 1px solid rgba(255,255,255,0.02);
            border-radius: 12px; padding: 18px; display: flex; flex-direction: column; gap: 14px;
        }
        .config-card-node:hover { border-color: rgba(0, 240, 255, 0.1); }
        
        .cyber-switch-container {
            display: flex; justify-content: space-between; align-items: center; width: 100%;
        }
        .switch-label-stack span { display: block; font-size: 0.9rem; font-weight: 600; }
        .switch-label-stack small { font-size: 0.72rem; color: var(--text-muted); font-family: var(--font-mono); }
        
        .cyber-toggle-input { display: none; }
        .cyber-toggle-label {
            width: 46px; height: 24px; background: #1e293b; display: block;
            border-radius: 20px; position: relative; cursor: pointer; border: 1px solid rgba(255,255,255,0.05);
        }
        .cyber-toggle-label::after {
            content: ''; position: absolute; width: 18px; height: 18px;
            background: #64748b; top: 2px; left: 2px; border-radius: 50%; transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .cyber-toggle-input:checked + .cyber-toggle-label { background: rgba(0, 240, 255, 0.15); border-color: var(--accent-primary); }
        .cyber-toggle-input:checked + .cyber-toggle-label::after { left: 24px; background: var(--accent-primary); box-shadow: 0 0 8px var(--accent-primary); }
        
        .cyber-range-slider {
            -webkit-appearance: none; width: 100%; height: 5px; background: #1e293b;
            border-radius: 4px; outline: none; margin-top: 5px;
        }
        .cyber-range-slider::-webkit-slider-thumb {
            -webkit-appearance: none; width: 14px; height: 14px; border-radius: 50%;
            background: var(--accent-primary); cursor: pointer; box-shadow: 0 0 6px var(--accent-primary);
        }

        /* PER-PAGE SCOPES NAVIGATION BAR */
        .scifi-subtabs-bar {
            display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; background: rgba(255,255,255,0.02);
            padding: 8px; border-radius: 10px; border: 1px dashed var(--glass-border);
        }
        .subtab-trigger {
            background: transparent; border: none; color: var(--text-muted); font-family: var(--font-mono);
            font-size: 0.78rem; padding: 6px 14px; cursor: pointer; border-radius: 6px; text-transform: uppercase;
        }
        .subtab-trigger.active {
            background: var(--accent-secondary); color: #fff; box-shadow: 0 0 10px rgba(255,0,127,0.3);
        }
        .page-scope-pane { display: none; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; margin-top: 15px; }
        .page-scope-pane.active { display: grid; }
        .matrix-checkbox-card {
            background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.03);
            border-radius: 8px; padding: 10px; display: flex; align-items: center; justify-content: space-between;
        }

        /* ===========================================================
           3. STANDARD STUDIO WORKSPACE MAPPING RULES
        =========================================================== */
        .studio-grid { display: grid; grid-template-columns: 440px 1fr; gap: 35px; align-items: start; }

        .control-panel {
            background: var(--bg-surface); border: 1px solid var(--glass-border); border-radius: 16px;
            padding: 24px; position: sticky; top: 30px; max-height: calc(100vh - 60px);
            overflow-y: auto; box-shadow: 0 15px 40px rgba(0,0,0,0.6);
        }
        .control-panel::-webkit-scrollbar { width: 4px; }
        .control-panel::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.05); border-radius: 2px; }
        .control-panel:hover::-webkit-scrollbar-thumb { background: var(--glass-border); }

        .panel-title { font-size: 1.15rem; font-weight: 700; margin-bottom: 20px; color: var(--accent-primary); display: flex; justify-content: space-between; align-items: center; }
        .panel-title.cert-panel-accent { color: var(--accent-warning); }
        .cancel-edit-btn { font-size: 0.75rem; font-family: var(--font-mono); color: var(--accent-secondary); cursor: pointer; display: none; margin-left: auto; margin-right: 10px; }

        .form-group { margin-bottom: 14px; }
        .form-group label { display: block; font-size: 0.75rem; font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.5px; }
        .form-control {
            width: 100%; background: var(--bg-card); border: 1px solid rgba(255,255,255,0.04);
            border-radius: 8px; padding: 10px 14px; color: var(--text-main); font-family: var(--font-sans); font-size: 0.95rem;
        }
        .form-control:focus { outline: none; border-color: var(--accent-primary); box-shadow: 0 0 10px rgba(0, 240, 255, 0.1); }
        .cert-panel-accent .form-control:focus { border-color: var(--accent-warning); box-shadow: 0 0 10px rgba(234, 179, 8, 0.1); }

        .btn-submit {
            width: 100%; background: rgba(255,255,255,0.02); border: 1px solid var(--accent-primary);
            color: var(--accent-primary); padding: 12px; border-radius: 8px; font-family: var(--font-mono);
            font-size: 0.9rem; font-weight: 600; cursor: pointer; margin-top: 10px;
        }
        .btn-submit:hover { background: var(--accent-primary); color: #000; box-shadow: 0 0 15px rgba(0,240,255,0.2); }
        .cert-submit-btn { border-color: var(--accent-warning); color: var(--accent-warning); }
        .cert-submit-btn:hover { background: var(--accent-warning); color: #000; box-shadow: 0 0 15px rgba(234,179,8,0.2); }

        .batch-toggle { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); cursor: pointer; display: inline-block; margin-top: 15px; border-bottom: 1px dashed var(--text-muted); padding-bottom: 2px; }
        .batch-area { display: none; margin-top: 12px; background: rgba(255,255,255,0.01); padding: 12px; border-radius: 8px; border: 1px dashed rgba(255,255,255,0.05); }

        .canvas-panel { display: flex; flex-direction: column; gap: 30px; }
        .hidden-space-node { display: none !important; }

        .search-filter-bar { background: var(--bg-surface); border: 1px solid var(--glass-border); padding: 16px; border-radius: 12px; display: grid; grid-template-columns: 2fr 1fr; gap: 15px; }

        .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px; border-bottom: 1px solid rgba(255,255,255,0.04); padding-bottom: 8px; }
        .section-header h2 { font-size: 1.3rem; display: flex; align-items: center; gap: 10px; font-weight: 600; }
        .section-header h2 i { color: var(--accent-primary); }
        .section-header h2.certs-title i { color: var(--accent-warning); }

        .manager-list { display: flex; flex-direction: column; gap: 10px; }
        .manager-card { background: var(--bg-card); border: 1px solid rgba(255,255,255,0.02); border-radius: 10px; padding: 16px; display: flex; justify-content: space-between; align-items: center; }
        .manager-card:hover { border-color: var(--glass-border); }
        
        .card-details h3 { font-size: 1.1rem; margin-bottom: 4px; font-weight: 600; }
        .card-meta { display: flex; flex-wrap: wrap; gap: 10px; font-size: 0.8rem; font-family: var(--font-mono); color: var(--text-muted); align-items: center; }
        .meta-tag { background: rgba(0, 240, 255, 0.04); padding: 1px 8px; border-radius: 4px; color: var(--accent-primary); border: 1px solid rgba(0, 240, 255, 0.08); }
        .meta-tag.cert-tag { background: rgba(234, 179, 8, 0.04); color: var(--accent-warning); border-color: rgba(234, 179, 8, 0.08); }
        .tech-pill { background: rgba(255,255,255,0.02); padding: 1px 6px; border-radius: 4px; color: var(--text-main); }

        .card-actions { display: flex; gap: 6px; align-items: center; }
        .btn-action { background: var(--bg-surface); border: 1px solid rgba(255,255,255,0.04); color: var(--text-muted); width: 34px; height: 34px; border-radius: 6px; cursor: pointer; display: grid; place-items: center; font-size: 0.9rem; }
        .btn-action:hover { color: var(--accent-primary); border-color: var(--accent-primary); background: rgba(0, 240, 255, 0.04); }
        .btn-action.btn-delete:hover { color: var(--accent-secondary); border-color: var(--accent-secondary); background: rgba(255, 0, 127, 0.04); }
        
        .ordering-docks { display: flex; flex-direction: column; gap: 2px; margin-right: 4px; }
        .order-nav-btn { background: transparent; border: none; color: var(--text-muted); cursor: pointer; font-size: 0.7rem; padding: 2px; display: block; }
        .order-nav-btn:hover { color: var(--accent-primary); }

        .recycle-bin-section { background: var(--bg-surface); padding: 25px; border-radius: 16px; border: 1px solid var(--accent-secondary) !important; }
        .audit-section { background: var(--bg-surface); padding: 25px; border-radius: 16px; border: 1px solid var(--glass-border) !important; }
        
        .timeline { display: flex; flex-direction: column; gap: 18px; margin-top: 20px; position: relative; padding-left: 20px; }
        .timeline::before { content: ''; position: absolute; left: 4px; top: 5px; bottom: 5px; width: 1px; background: rgba(255,255,255,0.08); }
        .timeline-item { position: relative; font-size: 0.9rem; padding-left: 10px; }
        .timeline-dot { position: absolute; left: -21px; top: 6px; width: 9px; height: 9px; border-radius: 50%; background: var(--text-muted); }
        .timeline-dot.CREATE { background: var(--accent-success) !important; box-shadow: 0 0 10px var(--accent-success); }
        .timeline-dot.UPDATE { background: var(--accent-primary) !important; box-shadow: 0 0 10px var(--accent-primary); }
        .timeline-dot.SOFT_DELETE { background: var(--accent-secondary) !important; box-shadow: 0 0 10px var(--accent-secondary); }
        .timeline-dot.RESTORE { background: var(--accent-warning) !important; box-shadow: 0 0 10px var(--accent-warning); }
    </style>
</head>
<body>

<div class="studio-container">
    <header>
        <h1>Dwivedi.AI <span>Studio Cockpit</span></h1>
        
        <div class="workspace-switcher">
            <button class="mode-btn active" id="globalProjectModeBtn" onclick="toggleGlobalStudioContext('PROJECT')">Projects Space</button>
            <button class="mode-btn" id="globalCertModeBtn" onclick="toggleGlobalStudioContext('CERT')">Credentials Space</button>
        </div>

        <div class="header-controls">
            <button class="theme-toggle-btn" id="themeToggle" title="Toggle Dashboard Theme"><i class="fa-solid fa-moon"></i></button>
            <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); background: var(--bg-surface); padding: 8px 14px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.04);">
                Cluster Stable <i class="fa-solid fa-circle" style="color: var(--accent-success); font-size: 0.5rem; margin-left: 4px;"></i>
            </div>
        </div>
    </header>

    <section class="vfx-registry-panel">
        <div class="section-header" style="margin-bottom: 0;">
            <h2><i class="fa-solid fa-sliders" style="color: var(--accent-secondary);"></i> Live Visual FX Telemetry Registry Control Board</h2>
            <button class="btn-submit" id="saveGlobalTuningBtn" style="margin: 0; width: auto; padding: 6px 20px; font-size: 0.8rem;" onclick="commitGlobalMatrixToggles()">Commit Matrix Settings</button>
        </div>
        
        <form id="vfxTuningForm">
            <div class="registry-grid-tracker">
                <div class="config-card-node">
                    <div class="cyber-switch-container">
                        <div class="switch-label-stack">
                            <span>Master VFX Engine</span>
                            <small>vfxEngineActive</small>
                        </div>
                        <input type="checkbox" id="vfxEngineActive" class="cyber-toggle-input" <%= settings.vfxEngineActive ? 'checked' : '' %>>
                        <label for="vfxEngineActive" class="cyber-toggle-label"></label>
                    </div>
                    <div class="form-group" style="margin: 0;">
                        <label style="font-size: 0.68rem;">Operational Sequence Mode</label>
                        <select id="systemExecutionMode" class="form-control" style="padding: 6px 10px; font-size: 0.8rem;">
                            <option value="ambient" <%= settings.systemExecutionMode === 'ambient' ? 'selected' : '' %>>Ambient Intervals (Standard)</option>
                            <option value="serial-test" <%= settings.systemExecutionMode === 'serial-test' ? 'selected' : '' %>>Serial Monitoring (Continuous Loop)</option>
                        </select>
                    </div>
                </div>

                <div class="config-card-node">
                    <div class="cyber-switch-container" style="border-bottom: 1px dashed rgba(255,255,255,0.05); padding-bottom: 4px;">
                        <div class="switch-label-stack"><span>Autonomic Schedulers</span><small>Interval Minutes</small></div>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 0.75rem; font-family: var(--font-mono);">
                        <div>
                            <label style="color: var(--text-muted); font-size: 0.65rem;">IRON MAN</label>
                            <input type="number" id="ironManIntervalMinutes" class="form-control" style="padding: 4px 8px; font-size: 0.8rem;" step="0.5" value="<%= settings.ironManIntervalMinutes %>">
                        </div>
                        <div>
                            <label style="color: var(--text-muted); font-size: 0.65rem;">THOR STRIKE</label>
                            <input type="number" id="thorIntervalMinutes" class="form-control" style="padding: 4px 8px; font-size: 0.8rem;" step="0.5" value="<%= settings.thorIntervalMinutes %>">
                        </div>
                        <div>
                            <label style="color: var(--text-muted); font-size: 0.65rem;">JETS SQUAD</label>
                            <input type="number" id="jetIntervalMinutes" class="form-control" style="padding: 4px 8px; font-size: 0.8rem;" step="0.5" value="<%= settings.jetIntervalMinutes %>">
                        </div>
                        <div>
                            <label style="color: var(--text-muted); font-size: 0.65rem;">STARS STREAM</label>
                            <input type="number" id="starIntervalMinutes" class="form-control" style="padding: 4px 8px; font-size: 0.8rem;" step="0.1" value="<%= settings.starIntervalMinutes %>">
                        </div>
                    </div>
                </div>

                <div class="config-card-node">
                    <div class="cyber-switch-container" style="margin-bottom: -4px;">
                        <div class="switch-label-stack"><small>Jet Deployment Multiplier</small></div>
                        <span id="jetSpawnCountVal" style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--accent-primary);"><%= settings.jetSpawnCount %> units</span>
                    </div>
                    <input type="range" id="jetSpawnCount" class="cyber-range-slider" min="1" max="5" step="1" value="<%= settings.jetSpawnCount %>" oninput="document.getElementById('jetSpawnCountVal').innerText=this.value+' units'">

                    <div class="cyber-switch-container" style="margin-bottom: -4px;">
                        <div class="switch-label-stack"><small>Cosmic Star Drifters Density</small></div>
                        <span id="starSpawnCountVal" style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--accent-primary);"><%= settings.starSpawnCount %> units</span>
                    </div>
                    <input type="range" id="starSpawnCount" class="cyber-range-slider" min="1" max="10" step="1" value="<%= settings.starSpawnCount %>" oninput="document.getElementById('starSpawnCountVal').innerText=this.value+' units'">
                </div>

                <div class="config-card-node">
                    <div class="cyber-switch-container" style="margin-bottom: -4px;">
                        <div class="switch-label-stack"><small>Firecracker Particles Volume</small></div>
                        <span id="fwDensityVal" style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--accent-warning);"><%= settings.fireworksParticleDensity %> count</span>
                    </div>
                    <input type="range" id="fireworksParticleDensity" class="cyber-range-slider" min="20" max="200" step="5" value="<%= settings.fireworksParticleDensity %>" oninput="document.getElementById('fwDensityVal').innerText=this.value+' count'">

                    <div class="cyber-switch-container" style="margin-bottom: -4px;">
                        <div class="switch-label-stack"><small>Click Verification Burst Odds</small></div>
                        <span id="fwOddsVal" style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--accent-warning);"><%= Math.round(settings.fireworksClickProbability * 100) %>%</span>
                    </div>
                    <input type="range" id="fireworksClickProbability" class="cyber-range-slider" min="0" max="1" step="0.01" value="<%= settings.fireworksClickProbability %>" oninput="document.getElementById('fwOddsVal').innerText=Math.round(this.value*100)+'%'">
                </div>

                <div class="config-card-node" style="justify-content: center;">
                    <div class="cyber-switch-container" style="margin-bottom: -2px;">
                        <div class="switch-label-stack"><small>Ironman Flight Timeline Duration</small></div>
                        <span id="ironDurationVal" style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--accent-secondary);"><%= settings.ironManFlightDuration %>s</span>
                    </div>
                    <input type="range" id="ironManFlightDuration" class="cyber-range-slider" min="0.5" max="15.0" step="0.1" value="<%= settings.ironManFlightDuration %>" oninput="document.getElementById('ironDurationVal').innerText=this.value+'s'">

                    <div class="cyber-switch-container" style="margin-bottom: -2px;">
                        <div class="switch-label-stack"><small>Thor Shock Extraction Duration</small></div>
                        <span id="thorDurationVal" style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--accent-secondary);"><%= settings.thorStrikeDuration %>s</span>
                    </div>
                    <input type="range" id="thorStrikeDuration" class="cyber-range-slider" min="0.4" max="10.0" step="0.1" value="<%= settings.thorStrikeDuration %>" oninput="document.getElementById('thorDurationVal').innerText=this.value+'s'">

                    <div class="cyber-switch-container" style="margin-bottom: -2px;">
                        <div class="switch-label-stack"><small>Sci-Fi Fighter Jet Flyby Speed</small></div>
                        <span id="jetDurationVal" style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--accent-secondary);"><%= settings.jetFlightDuration || 4.2 %>s</span>
                    </div>
                    <input type="range" id="jetFlightDuration" class="cyber-range-slider" min="0.5" max="15.0" step="0.1" value="<%= settings.jetFlightDuration || 4.2 %>" oninput="document.getElementById('jetDurationVal').innerText=this.value+'s'">

                    <div class="cyber-switch-container" style="margin-bottom: -2px;">
                        <div class="switch-label-stack"><small>Shooting Star Transversal Speed</small></div>
                        <span id="starDurationVal" style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--accent-secondary);"><%= settings.shootingStarDuration %>s</span>
                    </div>
                    <input type="range" id="shootingStarDuration" class="cyber-range-slider" min="0.2" max="6.0" step="0.1" value="<%= settings.shootingStarDuration %>" oninput="document.getElementById('starDurationVal').innerText=this.value+'s'">
                </div>
            </div>

            <div class="scifi-subtabs-bar">
                <button type="button" class="subtab-trigger active" onclick="switchScopeMatrixTab(event, 'pane-home')">Home View</button>
                <button type="button" class="subtab-trigger" onclick="switchScopeMatrixTab(event, 'pane-projects')">Work Grid</button>
                <button type="button" class="subtab-trigger" onclick="switchScopeMatrixTab(event, 'pane-certs')">Certs View</button>
                <button type="button" class="subtab-trigger" onclick="switchScopeMatrixTab(event, 'pane-about')">About Track</button>
                <button type="button" class="subtab-trigger" onclick="switchScopeMatrixTab(event, 'pane-contact')">Contact Panel</button>
            </div>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Studio Security Gateway</title>
    <script src="https://unpkg.com/@simplewebauthn/browser/dist/bundle/index.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <style>
        body {
            background-color: #0d1117;
            color: #c9d1d9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            box-sizing: border-box;
        }
        .login-container {
            background-color: #161b22;
            padding: 2.5rem;
            border-radius: 12px;
            border: 1px solid #30363d;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5);
            width: 100%;
            max-width: 420px;
        }
        h2 { text-align: center; color: #58a6ff; margin-bottom: 1.5rem; }
        fieldset {
            border: 1px solid #30363d;
            border-radius: 8px;
            padding: 1.2rem;
            margin-bottom: 1.5rem;
            background-color: #0d1117;
        }
        legend { color: #8b949e; padding: 0 0.5rem; font-size: 0.9rem; }
        input {
            width: 100%;
            padding: 0.65rem;
            margin-bottom: 1rem;
            background-color: #0d1117;
            border: 1px solid #30363d;
            border-radius: 6px;
            color: #c9d1d9;
            box-sizing: border-box;
        }
        input:focus { border-color: #58a6ff; outline: none; }
        button {
            width: 100%;
            padding: 0.7rem;
            background-color: #21262d;
            color: #c9d1d9;
            border: 1px solid #f0f6fc10;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s ease;
        }
        button:hover { background-color: #30363d; border-color: #8b949e; }
        .passkey-btn {
            background-color: #238636;
            color: #ffffff;
            border: none;
        }
        .passkey-btn:hover { background-color: #2ea043; }
        .signup-btn {
            background-color: #8b949e20;
            color: #58a6ff;
            border: 1px dashed #58a6ff40;
        }
        .signup-btn:hover { background-color: #58a6ff15; border-color: #58a6ff; }
        .divider { text-align: center; margin: 1rem 0; color: #8b949e; font-size: 0.85rem; }
        .notice { color: #58a6ff; font-size: 0.85rem; text-align: center; margin-bottom: 1rem; }
        .toggle-registration-link {
            display: block;
            text-align: center;
            font-size: 0.8rem;
            color: #8b949e;
            text-decoration: none;
            margin-top: 1rem;
            cursor: pointer;
        }
        .toggle-registration-link:hover { color: #58a6ff; text-decoration: underline; }
    </style>
</head>
<body>

<div class="login-container">
    <h2>Dwivedi.AI Studio Gateway</h2>

    <% if (authMode !== 'PASSKEY_ONLY') { %>
        <fieldset>
            <legend>Standard Access Channel</legend>
            <form action="/auth/login-password" method="POST">
                <input type="email" name="email" placeholder="Admin Email" required>
                <input type="password" name="password" placeholder="Master Password" required>
                <button type="submit">Unlock Workspace</button>
            </form>
        </fieldset>
    <% } else { %>
        <div class="notice">🛡️ High Security Shield Enforced:<br>Password channel bypassed via environment variables.</div>
    <% } %>

    <% if (authMode !== 'PASSWORD_ONLY') { %>
        <% if (authMode === 'HYBRID') { %>
            <div class="divider">─ OR ─</div>
        <% } %>
        <fieldset>
            <legend>Passwordless Biometric Enclave</legend>
            <input type="email" id="passkeyEmail" placeholder="Enter verified admin email address">
            <button class="passkey-btn" onclick="triggerPasskeyLogin()">Sign In with Passkey</button>
        </fieldset>
    <% } %>

    <% if (allowRegistration) { %>
        <a class="toggle-registration-link" onclick="toggleRegistrationForm()">➕ Provision New Admin Profile</a>
        
        <fieldset id="registrationDrawer" style="display: none; margin-top: 1rem; border-color: #58a6ff30;">
            <legend style="color: #58a6ff;">Account Initialization Ingestion</legend>
            <input type="email" id="regEmail" placeholder="New Admin Email" required>
            <input type="password" id="regPassword" placeholder="New Master Password" required>
            <button class="signup-btn" onclick="triggerPublicRegistration()">Register Admin Node</button>
        </fieldset>
    <% } %>
</div>

<script>
    // Toggle Account Creation Drawer visibility controls
    function toggleRegistrationForm() {
        const drawer = document.getElementById('registrationDrawer');
        if (drawer) {
            drawer.style.display = drawer.style.display === 'none' ? 'block' : 'none';
        }
    }

    // Process Asynchronous Administrator Account Creation Ingestion Sequences
    async function triggerPublicRegistration() {
        const email = document.getElementById('regEmail').value.trim();
        const password = document.getElementById('regPassword').value;

        if (!email || !password) return alert('Please satisfy all account credential form arguments.');

        try {
            const response = await axios.post('/auth/register-public', { email, password });
            if (response.data.success) {
                alert('⚡ [Studio Registry]: Admin profile successfully written to security database.');
                document.getElementById('regEmail').value = '';
                document.getElementById('regPassword').value = '';
                toggleRegistrationForm();
            }
        } catch (err) {
            alert('Registration Ingestion Aborted: ' + (err.response?.data?.error || err.message));
        }
    }

    // Process Passwordless FIDO2 / WebAuthn Signature Verification Handshakes
    async function triggerPasskeyLogin() {
        const email = document.getElementById('passkeyEmail').value.trim();
        if (!email) return alert('Please enter your administrator email first to resolve identity keys.');

        try {
            // Step 1: Request active FIDO2 challenge specifications from the server
            const challengeRes = await axios.post('/auth/login-challenge', { email });
            
            // Step 2: Pass challenge maps directly to local OS secure enclaves (Windows Hello/Android Fingerprint)
            const assertPayload = await SimpleWebAuthnBrowser.startAuthentication(challengeRes.data);
            
            // Step 3: Stream signed response object parameters back to verification endpoints
            const verifyRes = await axios.post('/auth/login-verify', { authResponse: assertPayload });
            
            if (verifyRes.data.verified) {
                window.location.href = '/';
            }
        } catch (err) {
            console.error(err);
            alert('Authentication Pipeline Refused: ' + (err.response?.data?.error || err.message));
        }
    }
</script>

</body>
</html>